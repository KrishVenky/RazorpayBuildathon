# ── Nexus-402 Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it's in .gitignore.

# ─ Solana ─────────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Get a free key at https://helius.dev (faster devnet)
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Set after: anchor deploy --provider.cluster devnet
PROGRAM_ID=

# ─ Quant Agent ────────────────────────────────────────────────────────────────
QUANT_AGENT_PORT=3001
# Run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# base58 private key — generate with: solana-keygen new --outfile quant-wallet.json
QUANT_AGENT_WALLET_PRIVATE_KEY=

# ─ Analyst Agent ──────────────────────────────────────────────────────────────
ANALYST_AGENT_PORT=3002
ANALYST_AGENT_ENDPOINT=http://localhost:3002
# Public key of the analyst agent wallet (used by Quant Agent to target escrow)
ANALYST_WALLET_PUBKEY=
# Path to downloaded FinBERT ONNX model
FINBERT_MODEL_PATH=./models/finbert
# Select inference backend: mock | onnx_cpu | hailo8_npu
INFERENCE_BACKEND=mock
# Set to 0 for Hailo-8 NPU device 0, -1 to force CPU
HAILO_DEVICE_ID=-1

# Real sentiment ingestion for ONNX backend
# CryptoPanic is the recommended first source for crypto-native news.
CRYPTOPANIC_API_KEY=
# Optional overrides / extra sources
# CRYPTOPANIC_API_URL=https://cryptopanic.com/api/free/v1/posts/
NEWSAPI_KEY=
GNEWS_API_KEY=
REDDIT_SUBREDDITS=CryptoCurrency,Bitcoin,ethereum,solana,defi
SENTIMENT_MAX_DOCS_PER_SYMBOL=24
SENTIMENT_FETCH_TIMEOUT_MS=8000

# ─ Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_ANALYST_ENDPOINT=http://localhost:3002
NEXT_PUBLIC_QUANT_ENDPOINT=http://localhost:3001

# ─ Demo / Development ─────────────────────────────────────────────────────────
# Set to true when anchor program is not deployed (skips on-chain calls, returns mock tx sigs)
MOCK_ANCHOR=false
